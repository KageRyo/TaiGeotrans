# TaiGeotrans 配置範例
# 複製此檔案為 .env 並根據需求調整

# TGOS credentials (obtain these from TGOS; never commit real values)
TGOS_APP_ID=
TGOS_API_KEY=

# TGOS QueryAddr endpoint
TGOS_API_BASE_URL=https://addr.tgos.tw/addrws/v30/QueryAddr.asmx/QueryAddr
TGOS_API_TIMEOUT=30

# HTTP 請求設定
HTTP_MAX_RETRIES=3
HTTP_RETRY_DELAY=1.0

# 日誌設定
LOG_LEVEL=INFO
